+            with self.subTest(key=key, value=value):
+                plan = self.plan()
+                plan['steps'][-1]['audit'][key] = value
+                with self.assertRaisesRegex(a04.Refusal, '^A04_AUDIT$'):
+                    a04.validate_plan(plan)
+
+    def test_custom_adapter_after_first_four_stays_refused(self):
