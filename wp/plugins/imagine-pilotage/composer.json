{
    "name": "imagine/pilotage",
    "description": "Règles métier Imagine, indépendantes de WordPress.",
    "type": "library",
    "require": {"php": "^8.2"},
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {"psr-4": {"Imagine\\Pilotage\\": "src/"}},
    "autoload-dev": {"psr-4": {"Imagine\\Pilotage\\Tests\\": "tests/"}},
    "scripts": {
        "test": "phpunit --fail-on-warning --fail-on-risky --fail-on-deprecation",
        "lint": "phpcs --standard=PSR12 src tests"
    },
    "config": {"allow-plugins": false, "sort-packages": true},
    "license": "proprietary"
}
