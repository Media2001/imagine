{
    "name": "imagine/connecteur",
    "description": "Cœur de file indépendant de WordPress et Odoo.",
    "type": "library",
    "require": {"php": "^8.2"},
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {"psr-4": {"Imagine\\Connecteur\\": "src/"}},
    "autoload-dev": {"psr-4": {"Imagine\\Connecteur\\Tests\\": "tests/"}},
    "scripts": {
        "test": "phpunit --fail-on-warning --fail-on-risky --fail-on-deprecation",
        "lint": "phpcs --standard=PSR12 src tests"
    },
    "config": {"allow-plugins": false, "sort-packages": true},
    "license": "proprietary"
}
