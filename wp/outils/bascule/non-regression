#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace Imagine\NonRegression;

require_once __DIR__ . '/a03/Policy.php';
require_once __DIR__ . '/a03/Report.php';
require_once __DIR__ . '/a03/Site.php';

if (!defined('IMAGINE_A03_LIBRARY_ONLY')) {
    ini_set('display_errors', '0');
    ini_set('log_errors', '0');
    ini_set('error_log', '/dev/null');
    ob_start();
    try {
        $exit = Site::main($argv);
        ob_end_clean();
        fwrite(STDOUT, "A03_OK non-regression.json\n");
        exit($exit);
    } catch (\Throwable $error) {
        ob_end_clean();
        $code = preg_match(
            '/\AA0[23]_[A-Z_]+\z/D',
            $error->getMessage()
        ) ? $error->getMessage() : 'A03_EXECUTION_FAILED';
        fwrite(STDERR, $code . "\n");
        exit(1);
    }
}
