#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace Imagine\NonRegression;

final class Policy
{
    public static function verified(array $marker): bool
    {
        return ($marker['status'] ?? null) === 'verified'
            && ($marker['offline_verified'] ?? null) === true
            && ($marker['runtime_probe_passed'] ?? null) === true;
    }

    public static function renewalAllowed(bool $requested, bool $verified, bool $safeRuntime): bool
    {
        return $requested && $verified && $safeRuntime;
    }
}

final class Report
{
    public static function compare(array $before, array $after): array
    {
        if (($before['schema'] ?? '') !== 'imagine-a03-v1' || ($after['schema'] ?? '') !== 'imagine-a03-v1') {
            throw new \RuntimeException('A03_REPORT_SCHEMA');
        }
        $changes = [];
        $walk = static function (mixed $a, mixed $b, string $path) use (&$walk, &$changes): void {
            if ($a === $b) {
                return;
            }
            if (is_array($a) && is_array($b)) {
                foreach (array_unique(array_merge(array_keys($a), array_keys($b))) as $key) {
                    $walk($a[$key] ?? null, $b[$key] ?? null, $path === '' ? (string) $key : $path . '.' . $key);
                }
                return;
            }
            $root = explode('.', $path)[0];
            if (in_array($root, ['generated_at_utc'], true)) {
                return;
            }
            $class = $root === 'versions' ? 'attendu' : (in_array($root, ['pages', 'renewal'], true) ? 'a regarder' : 'anormal');
            // Values deliberately excluded: even malformed inputs never echo PII.
            $changes[] = ['path' => preg_match('/\A[A-Za-z0-9_.:-]{1,240}\z/D', $path) ? $path : '[masque]', 'class' => $class];
        };
        $walk($before, $after, '');
        return ['schema' => 'imagine-a03-comparison-v1', 'changes' => $changes,
            'anormal' => count(array_filter($changes, static fn(array $c): bool => $c['class'] === 'anormal'))];
    }
}

final class Site
{
    public static function identifier(string $value): string
    {
        return \Imagine\Audit\Audit::identifier($value);
    }

    public static function json(string $path): array
    {
        if (!is_file($path) || is_link($path) || filesize($path) > 16777216) {
            throw new \RuntimeException('A03_JSON_FILE');
        }
        $value = json_decode(file_get_contents($path), true, 64, JSON_THROW_ON_ERROR);
        if (!is_array($value)) {
            throw new \RuntimeException('A03_JSON_FILE');
        }
        return $value;
    }

    public static function bootstrap(string $site, bool $write): void
    {
        if (!Policy::verified(self::json($site . '/.imagine-staging-verified.json'))) {
            throw new \RuntimeException('A03_NOT_VERIFIED');
        }
        $guard = $site . '/wp-content/mu-plugins/000-imagine-staging-safety.php';
        if (!is_file($guard) || is_link($guard) || hash_file('sha256', $guard) !== hash_file('sha256', __DIR__ . '/../staging/mu-plugins/000-imagine-staging-safety.php')) {
            throw new \RuntimeException('A03_SAFETY_BYTES');
        }
        define('IMAGINE_AUDIT_LIBRARY_ONLY', true);
        require_once __DIR__ . '/audit';
        $config = \Imagine\Audit\Audit::config(file_get_contents($site . '/wp-config.php'));
        $host = $config['DB_HOST'];
        if (!preg_match('~\Alocalhost:(/[^;\x00-\x1f]+)\z~D', $host, $match)) {
            throw new \RuntimeException('A03_UNIX_SOCKET_REQUIRED');
        }
        $db = new \PDO('mysql:unix_socket=' . $match[1] . ';dbname=' . $config['DB_NAME'], $config['DB_USER'], $config['DB_PASSWORD'], [\PDO::ATTR_ERRMODE => \PDO::ERRMODE_EXCEPTION]);
        if (!$write) {
            foreach ($db->query('SHOW GRANTS')->fetchAll(\PDO::FETCH_COLUMN) as $grant) {
                if (!preg_match('/\AGRANT (?:USAGE|SELECT) ON /D', $grant) || str_contains($grant, 'WITH GRANT OPTION')) {
                    throw new \RuntimeException('A03_SELECT_ACCOUNT_REQUIRED');
                }
            }
        }
        $db = null;
        unset($config);
        // No raw bootstrap output, personal values or plugin messages leave this process.
        require $site . '/wp-load.php';
        global $wpdb;
        $wpdb->suppress_errors(true);
        if (!function_exists('wc_memberships_user_can') || !function_exists('wcs_get_subscriptions')) {
            throw new \RuntimeException('A03_REQUIRED_EXTENSIONS');
        }
        require_once __DIR__ . '/../staging/runtime-probe.php';
        $probe = \Imagine\Staging\runtimeProbe();
        $required = ['mail_blocked', 'http_blocked', 'subscriptions_staging', 'environment_staging', 'cron_disabled', 'as_async_disabled', 'as_runner_disabled', 'gateways_disabled'];
        foreach ($required as $key) {
            if (($probe[$key] ?? null) !== true) {
                throw new \RuntimeException('A03_RUNTIME_UNSAFE');
            }
        }
        if (!$write) {
            $wpdb->query('SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ');
            $wpdb->query('START TRANSACTION READ ONLY');
        }
    }

    private static function subscriptions(): array
    {
        $result = [];
        for ($page = 1; ; $page++) {
            $batch = wcs_get_subscriptions(['subscriptions_per_page' => 100, 'paged' => $page, 'subscription_status' => 'any', 'orderby' => 'ID', 'order' => 'ASC']);
            foreach ($batch as $s) {
                $result[$s->get_id()] = $s;
            }
            if (count($batch) < 100) {
                break;
            }
            if ($page > 10000) {
                throw new \RuntimeException('A03_SUBSCRIPTIONS_LIMIT');
            }
        }
        ksort($result, SORT_NUMERIC);
        return $result;
    }

    public static function collect(array $settings): array
    {
        global $wpdb;
        $subs = self::subscriptions();
        $rows = [];
        $counts = ['status' => [], 'gateway' => [], 'period' => []];
        $userSubs = [];
        foreach ($subs as $id => $s) {
            $row = ['status' => self::identifier($s->get_status()), 'gateway' => self::identifier($s->get_payment_method() ?: 'manual'),
                'period' => self::identifier($s->get_billing_period()), 'interval' => (int) $s->get_billing_interval(),
                'next_payment_utc' => $s->get_date('next_payment', 'gmt')];
            $rows[$id] = $row;
            $userSubs[$s->get_user_id()][] = $row['status'];
            foreach (['status' => $row['status'], 'gateway' => $row['gateway'], 'period' => $row['interval'] . '-' . $row['period']] as $kind => $key) {
                $counts[$kind][$key] = ($counts[$kind][$key] ?? 0) + 1;
            }
        }
        foreach ($counts as &$group) {
            ksort($group);
        }
        unset($group);
        $userMembers = [];
        $memberships = [];
        foreach ($wpdb->get_col("SELECT ID FROM {$wpdb->posts} WHERE post_type='wc_user_membership' ORDER BY ID") as $id) {
            $m = wc_memberships_get_user_membership((int) $id);
            if (!$m) {
                throw new \RuntimeException('A03_MEMBERSHIP_READ');
            }
            $state = self::identifier($m->get_status());
            $userMembers[$m->get_user_id()][] = $state;
            $memberships[(int) $id] = ['user_id' => $m->get_user_id(), 'plan_id' => $m->get_plan_id(), 'status' => $state];
        }
        $samples = [];
        $membershipStates = ['none'];
        $subscriptionStates = ['none'];
        foreach ($wpdb->get_col("SELECT ID FROM {$wpdb->users} ORDER BY ID") as $id) {
            $id = (int) $id;
            $ms = array_unique($userMembers[$id] ?? ['none']);
            $ss = array_unique($userSubs[$id] ?? ['none']);
            sort($ms);
            sort($ss);
            $key = implode('+', $ms) . ':' . implode('+', $ss);
            $samples[$key] ??= $id;
            $membershipStates = array_merge($membershipStates, $ms);
            $subscriptionStates = array_merge($subscriptionStates, $ss);
        }
        ksort($samples);
        $access = [];
        $targets = $settings['restricted_ids'] ?? [];
        if (!$targets || !array_is_list($targets) || count($targets) > 100 || count($samples) > 1000) {
            throw new \RuntimeException('A03_SAMPLE_CONFIG');
        }
        foreach ($targets as $post) {
            if (!is_int($post) || !wc_memberships_is_post_content_restricted($post)) {
                throw new \RuntimeException('A03_CONTENT_NOT_RESTRICTED');
            }
            foreach (array_unique(array_merge([0], array_values($samples))) as $uid) {
                $access[$uid . ':' . $post] = wc_memberships_user_can($uid, 'view', ['post' => $post]);
            }
        }
        ksort($access, SORT_NATURAL);
        $actions = [];
        $actionDays = [];
        foreach ($wpdb->get_results("SELECT action_id,hook,scheduled_date_gmt FROM {$wpdb->prefix}actionscheduler_actions WHERE status='pending' ORDER BY action_id", ARRAY_A) as $a) {
            $hook = self::identifier($a['hook']);
            $date = $a['scheduled_date_gmt'];
            if (!preg_match('/\A[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\z/D', $date)) {
                throw new \RuntimeException('A03_ACTION_DATE');
            }
            $actions[(int) $a['action_id']] = ['hook' => $hook, 'date' => $date];
            $key = $hook . ':' . substr($date, 0, 10);
            $actionDays[$key] = ($actionDays[$key] ?? 0) + 1;
        }
        ksort($actionDays);
        [$months, $orders] = self::orders($settings['as_of_month'] ?? '');
        $membershipStates = array_values(array_unique($membershipStates));
        $subscriptionStates = array_values(array_unique($subscriptionStates));
        sort($membershipStates);
        sort($subscriptionStates);
        return ['schema' => 'imagine-a03-v1', 'generated_at_utc' => gmdate('c'),
            'versions' => ['wordpress' => get_bloginfo('version'), 'php' => PHP_VERSION, 'woocommerce' => WC()->version, 'memberships' => wc_memberships()->get_version(), 'subscriptions' => \WC_Subscriptions::$version],
            'storage' => \Automattic\WooCommerce\Utilities\OrderUtil::custom_orders_table_usage_is_enabled() ? 'hpos' : 'classic',
            'sample_states' => ['membership' => $membershipStates, 'subscription' => $subscriptionStates], 'samples' => $samples,
            'memberships' => $memberships, 'access' => $access, 'subscriptions' => $rows, 'subscription_counts' => $counts,
            'actions' => $actions, 'action_days' => $actionDays, 'order_months' => $months, 'orders' => $orders,
            'pages' => self::pages($settings['pages'] ?? []), 'renewal' => ['enabled' => false]];
    }

    private static function orders(string $month): array
    {
        if (!preg_match('/\A[0-9]{4}-(?:0[1-9]|1[0-2])\z/D', $month)) {
            throw new \RuntimeException('A03_MONTH_CONFIG');
        }
        $end = new \DateTimeImmutable($month . '-01 00:00:00', new \DateTimeZone('UTC'));
        $start = $end->modify('-11 months');
        $months = [];
        for ($i = 0; $i < 12; $i++) {
            $months[] = $start->modify('+' . $i . ' months')->format('Y-m');
        }
        $result = [];
        for ($page = 1; ; $page++) {
            $orders = wc_get_orders(['type' => 'shop_order', 'status' => array_keys(wc_get_order_statuses()), 'limit' => 100, 'page' => $page, 'orderby' => 'ID', 'order' => 'ASC']);
            foreach ($orders as $order) {
                $date = $order->get_date_created();
                if (!$date) {
                    throw new \RuntimeException('A03_ORDER_DATE');
                }
                $m = gmdate('Y-m', $date->getTimestamp());
                if (!in_array($m, $months, true)) {
                    continue;
                }
                $currency = $order->get_currency();
                if (!preg_match('/\A[A-Z]{3}\z/D', $currency)) {
                    throw new \RuntimeException('A03_ORDER_CURRENCY');
                }
                $key = $m . ':' . self::identifier($order->get_status()) . ':' . $currency;
                $precision = wc_get_price_decimals();
                $result[$key] ??= ['count' => 0, 'amount_minor' => 0, 'decimals' => $precision];
                $value = $order->get_total();
                if (!preg_match('/\A-?[0-9]{1,10}(?:\.[0-9]{1,8})?\z/D', $value)) {
                    throw new \RuntimeException('A03_ORDER_AMOUNT');
                }
                $result[$key]['count']++;
                $result[$key]['amount_minor'] += (int) round((float) $value * (10 ** $precision));
            }
            if (count($orders) < 100) {
                break;
            }
            if ($page > 10000) {
                throw new \RuntimeException('A03_ORDERS_LIMIT');
            }
        }
        ksort($result);
        return [$months, $result];
    }

    private static function pages(array $pages): array
    {
        if (array_keys($pages) !== ['home', 'open', 'restricted', 'shop', 'cart', 'checkout', 'account']) {
            throw new \RuntimeException('A03_PAGES_CONFIG');
        }
        $base = rtrim(home_url(), '/');
        $result = [];
        foreach ($pages as $key => $page) {
            $path = $page['path'] ?? '';
            $marker = $page['marker'] ?? '';
            if (!is_string($path) || !preg_match('~\A/(?!/)[A-Za-z0-9_/?=&.%-]*\z~D', $path)
                || !is_string($marker) || !preg_match('/\A[A-Za-z0-9_-]{3,100}\z/D', $marker)) {
                throw new \RuntimeException('A03_PAGE_PATH_OR_MARKER');
            }
            $url = $base . $path;
            $first = null;
            $status = 0;
            $body = '';
            for ($redirect = 0; $redirect < 4; $redirect++) {
                $context = stream_context_create(['http' => ['method' => 'GET', 'follow_location' => 0, 'ignore_errors' => true, 'timeout' => 15, 'header' => "Connection: close\r\n"]]);
                $http_response_header = [];
                $handle = @fopen($url, 'rb', false, $context);
                $body = $handle === false ? '' : stream_get_contents($handle, 4194305);
                if (is_resource($handle)) {
                    fclose($handle);
                }
                $location = null;
                foreach ($http_response_header as $header) {
                    if (preg_match('~\AHTTP/\S+ ([0-9]{3})~', $header, $match)) {
                        $status = (int) $match[1];
                    }
                    if (stripos($header, 'Location: ') === 0) {
                        $location = trim(substr($header, 10));
                    }
                }
                $first ??= $status;
                if ($status < 300 || $status > 399 || $location === null) {
                    break;
                }
                $next = str_starts_with($location, '/') && !str_starts_with($location, '//') ? $base . $location : $location;
                if (!str_starts_with($next, $base . '/') || preg_match('/[\\\\\x00-\x20]/', $next)) {
                    break;
                }
                $url = $next;
            }
            $result[$key] = ['status' => $first, 'final_status' => $status, 'marker' => strlen($body) <= 4194304 && str_contains($body, $marker),
                'php_error' => (bool) preg_match('/(?:Fatal error|Parse error|Warning:|Notice:|Deprecated:|Uncaught (?:Error|Exception))/i', $body)];
        }
        return $result;
    }

    public static function main(array $args): int
    {
        $options = [];
        foreach (array_slice($args, 1) as $arg) {
            if (!preg_match('/\A--(wp-path|config|output)=(.+)\z/D', $arg, $m) || isset($options[$m[1]])) {
                throw new \RuntimeException('A03_USAGE');
            }
            $options[$m[1]] = $m[2];
        }
        if (count($options) !== 3 || PHP_SAPI !== 'cli') {
            throw new \RuntimeException('A03_USAGE');
        }
        $site = realpath($options['wp-path']);
        $parent = realpath(dirname($options['output']));
        $base = basename($options['output']);
        if (!$site || !$parent || !is_dir($site) || !preg_match('/\A[A-Za-z0-9_-]+\z/D', $base)
            || $parent === $site || str_starts_with($parent . '/', $site . '/') || file_exists($parent . '/' . $base)) {
            throw new \RuntimeException('A03_PATH_UNSAFE_OR_EXISTS');
        }
        $settings = self::json($options['config']);
        self::bootstrap($site, false);
        $report = self::collect($settings);
        global $wpdb;
        $wpdb->query('ROLLBACK');
        $output = $parent . '/' . $base;
        if (!mkdir($output, 0700)) {
            throw new \RuntimeException('A03_OUTPUT_FAILED');
        }
        file_put_contents($output . '/non-regression.json', json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
        chmod($output . '/non-regression.json', 0600);
        return 0;
    }
}

if (!defined('IMAGINE_A03_LIBRARY_ONLY')) {
    ini_set('display_errors', '0');
    ini_set('log_errors', '0');
    ini_set('error_log', '/dev/null');
    ob_start();
    try {
        $exit = Site::main($argv);
        ob_end_clean();
        fwrite(STDOUT, "A03_OK non-regression.json\n");
        exit($exit);
    } catch (\Throwable $error) {
        ob_end_clean();
        $code = preg_match('/\AA0[23]_[A-Z_]+\z/D', $error->getMessage()) ? $error->getMessage() : 'A03_EXECUTION_FAILED';
        fwrite(STDERR, $code . "\n");
        exit(1);
    }
}
