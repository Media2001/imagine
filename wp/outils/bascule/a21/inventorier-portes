#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace Imagine\ExternalDoors;

ini_set('display_errors', '0');
ini_set('log_errors', '0');
set_error_handler(static function (int $severity): bool {
    if (error_reporting() & $severity) {
        throw new \RuntimeException('A21_RUNTIME_WARNING');
    }
    return true;
});
try {
    require dirname(__DIR__) . '/a12/AuditLibrary.php';
    \Imagine\ContentInventory\AuditLibrary::load();
    require dirname(__DIR__) . '/a11/Runtime.php';
    require dirname(__DIR__) . '/a12/Command.php';
    require __DIR__ . '/Analysis.php';
    require __DIR__ . '/Inventory.php';
    require __DIR__ . '/Command.php';
    $code = Command::main($argv);
    fwrite(STDOUT, "A21_OK portes.json portes.md\n");
    exit($code);
} catch (\Throwable $error) {
    $known = [
        'A11_CONFIG_OVERRIDE_UNSUPPORTED', 'A11_CONFIG_UNSAFE', 'A11_DROPIN_UNSUPPORTED',
        'A11_HOME_INVALID', 'A11_MULTISITE_UNSUPPORTED', 'A11_READONLY_TRANSACTION_FAILED',
        'A11_SYMLINK_UNSUPPORTED', 'A11_WRITE_FORBIDDEN',
        'A21_USAGE', 'A21_OUTPUT_UNSAFE', 'A21_OUTPUT_EXISTS', 'A21_AUDIT_GUARD',
        'A21_CONFINEMENT_REQUIRED', 'A21_CLOCK_INVALID', 'A21_NATIVE_API_UNAVAILABLE',
        'A21_QUERY_FAILED', 'A21_STORE_SCHEMA_UNSUPPORTED', 'A21_AUDIT_STORAGE_MISMATCH',
        'A21_OUTPUT_CREATE', 'A21_OUTPUT_WRITE', 'A21_RUNTIME_WARNING',
    ];
    $code = in_array($error->getMessage(), $known, true) ? $error->getMessage() : 'A21_INVENTORY_FAILED';
    $message = class_exists(\Imagine\PublicAddresses\Runtime::class)
        ? \Imagine\PublicAddresses\Runtime::refusalMessage($error, $code) : $code;
    fwrite(STDERR, $message . "\n");
    exit(1);
}
