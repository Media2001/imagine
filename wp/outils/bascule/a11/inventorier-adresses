#!/usr/bin/env php
<?php

declare(strict_types=1);

define('IMAGINE_AUDIT_LIBRARY_ONLY', true);
if (getenv('A22_SUPERVISED') !== 'A11') {
    require_once dirname(__DIR__) . '/stream_bridge.php';
    exit(Imagine\StreamGuard\launch('A11', $argv));
}
require_once dirname(__DIR__) . '/audit';
require_once __DIR__ . '/Address.php';
require_once __DIR__ . '/Runtime.php';
require_once __DIR__ . '/Inventory.php';
require_once __DIR__ . '/Command.php';

$level = ob_get_level();
ob_start();
try {
    $code = Imagine\PublicAddresses\Command::main($argv);
    while (ob_get_level() > $level) {
        ob_end_clean();
    }
    fwrite(STDOUT, "A11_OK adresses.csv adresses.json resume.md\n");
    exit($code);
} catch (Throwable $error) {
    while (ob_get_level() > $level) {
        ob_end_clean();
    }
    $message = preg_match('/\AA(?:11|02)_[A-Z0-9_]+\z/D', $error->getMessage()) ? $error->getMessage() : 'A11_FAILED';
    fwrite(STDERR, Imagine\PublicAddresses\Runtime::refusalMessage($error, $message) . "\n");
    exit(1);
}
