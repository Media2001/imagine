#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace Imagine\RetentionInventory;

ini_set('display_errors', '0');
ini_set('log_errors', '0');
set_error_handler(static function (int $severity): bool {
    if (error_reporting() & $severity) {
        throw new \RuntimeException('A18_RUNTIME_WARNING');
    }
    return true;
});
$level = ob_get_level();
ob_start();
try {
    require dirname(__DIR__) . '/a12/AuditLibrary.php';
    \Imagine\ContentInventory\AuditLibrary::load();
    require dirname(__DIR__) . '/a11/Runtime.php';
    require dirname(__DIR__) . '/a12/Command.php';
    require __DIR__ . '/Forms.php';
    require __DIR__ . '/Inventory.php';
    require __DIR__ . '/Command.php';
    $code = Command::main($argv);
    while (ob_get_level() > $level) {
        ob_end_clean();
    }
    fwrite(STDOUT, "A18_OK conservation.json conservation.md\n");
    exit($code);
} catch (\Throwable $error) {
    while (ob_get_level() > $level) {
        ob_end_clean();
    }
    $known = [
        'A02_AUDIT_FAILED', 'A02_CONFIG_NON_LITERAL',
        'A02_DB_HOST_UNSUPPORTED', 'A02_DB_NAME_UNSUPPORTED',
        'A02_EXPECTED_TABLE_MISSING', 'A02_FILE_TREE_LIMIT',
        'A02_FILE_UNREADABLE_OR_TOO_LARGE', 'A02_LOG_UNREADABLE',
        'A02_MULTISITE_UNSUPPORTED', 'A02_NON_SELECT_FORBIDDEN',
        'A02_OUTPUT_CREATE_FAILED', 'A02_OUTPUT_UNSAFE_OR_EXISTS',
        'A02_OUTPUT_WRITE_FAILED', 'A02_PATH_INVALID',
        'A02_RUNTIME_WARNING', 'A02_SERIALIZED_TOO_LARGE',
        'A02_SYMLINK_UNSUPPORTED', 'A02_TABLE_IDENTIFIER_UNSUPPORTED',
        'A02_USAGE', 'A11_ATTACHMENT_PARENT_CYCLE',
        'A11_AUDIT_GUARD', 'A11_CONFIG_OVERRIDE_UNSUPPORTED',
        'A11_CONFIG_UNSAFE', 'A11_DROPIN_UNSUPPORTED',
        'A11_HOME_INVALID', 'A11_MULTISITE_UNSUPPORTED',
        'A11_NATIVE_URL_MISSING', 'A11_OUTPUT_CREATE',
        'A11_OUTPUT_EXISTS', 'A11_OUTPUT_UNSAFE',
        'A11_OUTPUT_WRITE', 'A11_PATH_INVALID',
        'A11_POSTS_FAILED', 'A11_POST_READ_FAILED',
        'A11_READONLY_TRANSACTION_FAILED', 'A11_READ_FAILED',
        'A11_SYMLINK_UNSUPPORTED', 'A11_TERMS_FAILED',
        'A11_USAGE', 'A11_WRITE_FORBIDDEN',
        'A12_ATTACHMENT_PATH_UNSAFE', 'A12_AUDIT_GUARD',
        'A12_AUDIT_LIBRARY_GUARD', 'A12_AUDIT_STORAGE_MISMATCH',
        'A12_CONFIG_UNSAFE', 'A12_CONFINED',
        'A12_CONFINEMENT_REQUIRED', 'A12_DUPLICATE_ATTACHED_FILE',
        'A12_MULTISITE_UNSUPPORTED', 'A12_OUTPUT_CREATE',
        'A12_OUTPUT_EXISTS', 'A12_OUTPUT_UNSAFE',
        'A12_OUTPUT_WRITE', 'A12_PATH_INVALID',
        'A12_READ_FAILED', 'A12_SELECT_ONLY',
        'A12_TABLE_MISSING', 'A12_TRANSACTIONAL_TABLES_REQUIRED',
        'A12_UPLOAD_PATH_UNSUPPORTED', 'A12_USAGE',
        'A18_AUDIT_GUARD', 'A18_AUDIT_STORAGE_MISMATCH',
        'A18_CONFINED', 'A18_CONFINEMENT_REQUIRED',
        'A18_INVENTORY_FAILED', 'A18_OUTPUT_CREATE',
        'A18_OUTPUT_EXISTS', 'A18_OUTPUT_UNSAFE',
        'A18_OUTPUT_WRITE', 'A18_QUERY_FAILED',
        'A18_RUNTIME_WARNING', 'A18_UPLOAD_ROOT_UNSAFE',
        'A18_USAGE',
    ];
    $code = in_array($error->getMessage(), $known, true)
        ? $error->getMessage() : 'A18_INVENTORY_FAILED';
    $message = class_exists(\Imagine\PublicAddresses\Runtime::class)
        ? \Imagine\PublicAddresses\Runtime::refusalMessage($error, $code) : $code;
    fwrite(STDERR, $message . "\n");
    exit(1);
}
