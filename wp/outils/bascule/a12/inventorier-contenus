#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace Imagine\ContentInventory;

ini_set('display_errors', '0');
ini_set('log_errors', '0');
set_error_handler(static function (int $severity): bool {
    if (error_reporting() & $severity) {
        throw new \RuntimeException('A12_RUNTIME_WARNING');
    }
    return true;
});
$level = ob_get_level();
ob_start();
try {
    require __DIR__ . '/AuditLibrary.php';
    AuditLibrary::load();
    require dirname(__DIR__) . '/a11/Runtime.php';
    require __DIR__ . '/Registry.php';
    require __DIR__ . '/Inventory.php';
    require __DIR__ . '/Command.php';
    $code = Command::main($argv);
    while (ob_get_level() > $level) {
        ob_end_clean();
    }
    fwrite(STDOUT, "A12_OK contenus.json contenus.md\n");
    exit($code);
} catch (\Throwable $exception) {
    while (ob_get_level() > $level) {
        ob_end_clean();
    }
    $code = $exception instanceof \RuntimeException
        && preg_match('/\AA(?:12|11|02)_[A-Z_]+\z/D', $exception->getMessage())
        ? $exception->getMessage() : 'A12_INVENTORY_FAILED';
    $message = $code;
    if (class_exists(\Imagine\PublicAddresses\Runtime::class)) {
        $message = \Imagine\PublicAddresses\Runtime::refusalMessage($exception, $code);
    }
    fwrite(STDERR, $message . "\n");
    exit(1);
}
